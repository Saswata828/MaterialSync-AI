# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ================================================================
# FIREBASE CONFIGURATION (For Google Sign-In & Firebase Auth)
# Get these from Firebase Console -> Project Settings -> General -> Web App
# ================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ================================================================
# REAL EMAIL OTP CONFIGURATION (Nodemailer SMTP / Gmail App Password)
# Used to send real 6-digit verification codes to users' email addresses.
# For Gmail: Use smtp.gmail.com, port 465, your gmail address, and a Google App Password
# (Generate at: https://myaccount.google.com/apppasswords)
# ================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MaterialSync AI Portal <no-reply@materialsync.gov.in>"
